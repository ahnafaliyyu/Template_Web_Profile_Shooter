# Salin menjadi .env.local lalu isi.
# Tanpa DATABASE_URL situs tetap jalan memakai data cadangan (src/server/db/sample.ts).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Login admin (GitHub OAuth). Buat OAuth App di GitHub, callback: {SITE}/api/auth/callback/github
AUTH_SECRET=              # buat dengan: npx auth secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_USERS=username-github-kamu
