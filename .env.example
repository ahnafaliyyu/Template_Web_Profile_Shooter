# Salin menjadi .env.local lalu isi. Cek dengan: npm run doctor
# Tanpa DATABASE_URL situs publik tetap jalan memakai data cadangan (src/server/db/sample.ts).

# Database (Neon): tempel connection string dari dashboard Neon
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Login admin (GitHub OAuth). Callback: {alamat-situs}/api/auth/callback/github
AUTH_SECRET=              # buat dengan: npx auth secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_USERS=username-github-kamu   # pisahkan dengan koma bila lebih dari satu

# Unggah gambar (Vercel Blob), opsional sampai kamu mau mengunggah gambar
BLOB_READ_WRITE_TOKEN=
